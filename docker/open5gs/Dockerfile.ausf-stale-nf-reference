# syntax=docker/dockerfile:1.4
# open5gs_source must be a clean, separately supplied source snapshot.
ARG OPEN5GS_RUNTIME_IMAGE=docker_open5gs:local-arm64
FROM ubuntu:focal AS builder

ARG BUILD_JOBS=2
ENV DEBIAN_FRONTEND=noninteractive
RUN test "$(dpkg --print-architecture)" = arm64 \
 && test "$BUILD_JOBS" -ge 1 && test "$BUILD_JOBS" -le 2 \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential pkg-config meson ninja-build cmake flex bison git \
      python3 python3-setuptools ca-certificates patchelf \
      libsctp-dev libgnutls28-dev libgcrypt20-dev libssl-dev libidn11-dev \
      libmongoc-dev libbson-dev libyaml-dev libmicrohttpd-dev \
      libcurl4-gnutls-dev libnghttp2-dev libtins-dev libtalloc-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /open5gs
COPY --from=open5gs_source / /open5gs/
COPY test/open5gs/patches/patch-ausf-stale-nf-reference.py /opt/patches/
RUN test ! -e build-local && test ! -e install \
 && python3 -B /opt/patches/patch-ausf-stale-nf-reference.py \
      --source-root /open5gs --apply \
 && meson setup build-local /open5gs --prefix=/open5gs/install \
      --libdir=lib/aarch64-linux-gnu \
 && ninja -C build-local -j "$BUILD_JOBS" src/ausf/open5gs-ausfd \
 && patchelf --set-rpath /open5gs/install/lib/aarch64-linux-gnu \
      build-local/src/ausf/open5gs-ausfd

FROM ${OPEN5GS_RUNTIME_IMAGE} AS runtime
COPY --from=builder /open5gs/build-local/src/ausf/open5gs-ausfd /open5gs/install/bin/open5gs-ausfd
COPY test/open5gs/patches/patch-ausf-stale-nf-reference.py /opt/open5gs-patches/
RUN python3 -B - <<'CHECK'
import subprocess
binary = "/open5gs/install/bin/open5gs-ausfd"
result = subprocess.run(["ldd", binary], capture_output=True, text=True)
if result.returncode or "not found" in result.stdout:
    raise SystemExit(result.stdout + result.stderr)
subprocess.run([binary, "-v"], check=True)
with open(binary, "rb") as stream:
    if b"AUSF cleared stale NF references" not in stream.read():
        raise SystemExit("Patch marker missing from AUSF binary")
print("PASS: runtime linkage, version and compiled patch marker")
CHECK
