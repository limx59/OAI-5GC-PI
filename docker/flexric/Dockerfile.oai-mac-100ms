FROM ubuntu:24.04 AS builder

ARG BUILD_JOBS=2
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build pkg-config git ca-certificates \
    autoconf automake libtool bison flex patch ccache \
    python3 python3-dev python3-yaml xxd \
    libreadline-dev libconfig-dev libsctp-dev libssl-dev zlib1g-dev \
    libyaml-cpp-dev libpcre2-dev libcap-dev libzstd-dev \
    flatbuffers-compiler libflatbuffers-dev libnanomsg-dev libzmq3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/mouse07410/asn1c /tmp/asn1c \
    && cd /tmp/asn1c \
    && git checkout 940dd5fa9f3917913fd487b13dfddfacd0ded06e \
    && autoreconf -iv \
    && CFLAGS="-O2 -fno-strict-aliasing" ./configure --prefix=/opt/asn1c \
    && make -j"${BUILD_JOBS}" \
    && make install \
    && rm -rf /tmp/asn1c

RUN git clone https://github.com/simd-everywhere/simde-no-tests.git /tmp/simde \
    && cd /tmp/simde \
    && git checkout 1c68d9ad60bf63f3fb527c4ee3b2319d828ffcc6 \
    && cp -r /tmp/simde /usr/include/ \
    && rm -rf /tmp/simde


# Use the SDK matching the OAI gNB; keep repository sources unchanged.
COPY oai/openair2/E2AP/flexric/ /src/flexric/
COPY test/xapp/xapp_oai_n2_bidirectional.c /src/test/xapp/xapp_oai_ue_context.c
COPY test/flexric/patches/prepare-oai-ue-context.py /src/prepare-oai-ue-context.py
RUN python3 /src/prepare-oai-ue-context.py
COPY test/xapp/xapp_oai_mac_counters.c /src/test/xapp/xapp_oai_mac_counters.c
COPY test/flexric/patches/prepare-oai-mac-counters.py /src/prepare-oai-mac-counters.py
RUN python3 /src/prepare-oai-mac-counters.py

RUN cmake -S /src/flexric -B /build/flexric -G Ninja \
    -DCMAKE_BUILD_TYPE=Debug \
    -DCMAKE_INSTALL_PREFIX=/usr/local \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_MODULE_PATH=/src/flexric/examples/xApp/c/monitor/RRC_MESSAGES \
    -DE2AP_VERSION=E2AP_V2 \
    -DKPM_VERSION=KPM_V3_00 \
    -DXAPP_DB=SQLITE3_XAPP \
    -DXAPP_MULTILANGUAGE=OFF \
    -DUNIT_TEST=OFF \
    && cmake --build /build/flexric --parallel "${BUILD_JOBS}" \
       --target xapp_oai_ue_context xapp_oai_mac_counters mac_sm rlc_sm pdcp_sm slice_sm tc_sm gtp_sm kpm_sm rc_sm \
    && DESTDIR=/stage cmake --install /build/flexric \
    && install -D -m 755 /build/flexric/examples/xapp_oai_ue_context \
       /stage/usr/local/bin/xapp_oai_ue_context \
    && install -D -m 755 /build/flexric/examples/xapp_oai_mac_counters \
       /stage/usr/local/bin/xapp_oai_mac_counters \
    && install -D -m 644 /build/flexric/28_552_kpm_meas.txt \
       /stage/opt/oai-context/28_552_kpm_meas.txt

# Reuse the existing build, then rebuild only the MAC collector and plugin.
COPY test/flexric/patches/prepare-oai-mac-100ms.py /src/prepare-oai-mac-100ms.py
RUN python3 /src/prepare-oai-mac-100ms.py \
    && cmake --build /build/flexric --parallel "${BUILD_JOBS}" \
       --target xapp_oai_mac_counters mac_sm \
    && DESTDIR=/stage cmake --install /build/flexric \
    && install -D -m 755 /build/flexric/examples/xapp_oai_mac_counters \
       /stage/usr/local/bin/xapp_oai_mac_counters

FROM ubuntu:24.04 AS xapp
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    libconfig9 libsctp1 libstdc++6 libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /stage/ /
RUN ldconfig
WORKDIR /opt/oai-context
ENTRYPOINT ["stdbuf", "-oL", "-eL", "/usr/local/bin/xapp_oai_mac_counters"]
CMD ["-c", "/usr/local/etc/flexric/flexric.conf"]
