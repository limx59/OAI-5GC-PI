FROM limx59/oai-pi-ocudu-kpm-tests:arm64-style4-record-guard AS test
ARG BUILD_JOBS=1

COPY test/ocudu/patches/patch-ocudu-kpm-collection-lock.py /tmp/collection-lock.py
COPY test/ocudu/patches/kpm-collection-lock-tests.inc /tmp/collection-lock-tests.inc

RUN python3 /tmp/collection-lock.py /src/ocudu \
    && printf '\n' >> /src/ocudu/tests/unittests/e2/e2sm_kpm_test.cpp \
    && cat /tmp/collection-lock-tests.inc >> /src/ocudu/tests/unittests/e2/e2sm_kpm_test.cpp \
    && cmake --build /build/ocudu --target e2sm_kpm_test --parallel "${BUILD_JOBS}"

RUN timeout --signal=TERM --kill-after=5s 180s \
    /build/ocudu/tests/unittests/e2/e2sm_kpm_test \
    '--gtest_filter=e2sm_kpm_collection_lock.*:e2sm_kpm_style4_record_guard.*:e2sm_kpm_report_service_style2_test.*:*e2sm_kpm_generates_ric_indication_style4*'
