FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-numpy python3-zmq \
    && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
WORKDIR /opt/zmq-iq-bridge
COPY test/ocudu/zmq_iq_bridge_core.py ./
COPY test/ocudu/validate-zmq-iq-bridge-core.py ./
RUN python3 -B validate-zmq-iq-bridge-core.py \
    && python3 -B -c "import zmq; print('PyZMQ:', zmq.__version__)"
COPY test/ocudu/zmq_iq_bridge_source_mute.py ./
COPY test/ocudu/validate-zmq-iq-bridge-source-mute.py ./
RUN --network=none python3 -B validate-zmq-iq-bridge-source-mute.py
STOPSIGNAL SIGINT
ENTRYPOINT ["python3", "-B", "-u", "/opt/zmq-iq-bridge/zmq_iq_bridge_source_mute.py"]
CMD ["--help"]
