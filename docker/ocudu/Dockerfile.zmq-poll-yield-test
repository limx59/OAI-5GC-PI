# Experimental OCUDU Split 8 gNB for Raspberry Pi 5.
# Source remains unchanged; build uses a Docker copy.
FROM ubuntu:24.04 AS builder

ARG BUILD_JOBS=2
ARG MCPU=cortex-a76+crypto
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build pkg-config git ca-certificates \
    python3 libfftw3-dev libmbedtls-dev libsctp-dev libyaml-cpp-dev \
    libzmq3-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY ocudu/ /src/ocudu/

RUN pkg-config --exists libzmq \
    && cmake -S /src/ocudu -B /build/ocudu -G Ninja \
       -DCMAKE_BUILD_TYPE=Release \
       -DMCPU="${MCPU}" \
       -DMARCH=armv8.2-a \
       -DBUILD_TESTING=OFF \
       -DENABLE_ZEROMQ=ON \
       -DENABLE_EXPORT=ON \
       -DENABLE_FFTW=ON \
       -DENABLE_UHD=OFF \
       -DENABLE_SIDEKIQ=OFF \
       -DENABLE_DIFI=OFF \
       -DENABLE_DPDK=OFF \
       -DENABLE_CUDA=OFF \
       -DENABLE_MKL=OFF \
       -DENABLE_FFTZ=OFF \
       -DENABLE_ARMPL=OFF \
       -DENABLE_BACKWARD=OFF \
       -DENABLE_PLUGINS=OFF \
    && cmake --build /build/ocudu \
       --target gnb_split_8 --parallel "${BUILD_JOBS}"

RUN test -s /build/ocudu/apps/gnb_split_8/gnb \
    && mkdir -p /stage/opt/ocudu/bin \
    && install -m 755 /build/ocudu/apps/gnb_split_8/gnb \
       /stage/opt/ocudu/bin/gnb

# Diagnostic only: honor an explicit worker count within available CPUs.
FROM builder AS worker-test-builder
ARG BUILD_JOBS=2

RUN python3 - <<'PATCH'
from pathlib import Path
p = Path("/src/ocudu/apps/services/worker_manager/worker_manager.cpp")
text = p.read_text()
old = """  if (worker_cfg.nof_main_pool_threads.has_value()) {
    nof_workers = worker_cfg.nof_main_pool_threads.value();
  } else {"""
new = """  if (worker_cfg.nof_main_pool_threads.has_value()) {
    return std::max(1U, std::min(worker_cfg.nof_main_pool_threads.value(), avail_cpus));
  } else {"""
if text.count(old) != 1:
    raise SystemExit("Unexpected worker-count anchor")
p.write_text(text.replace(old, new, 1))
print("Applied diagnostic explicit-worker override to Docker source copy.")
PATCH

RUN cmake --build /build/ocudu --target gnb_split_8 --parallel "${BUILD_JOBS}" \
    && install -m 755 /build/ocudu/apps/gnb_split_8/gnb /stage/opt/ocudu/bin/gnb

# Experimental CPU-yield comparison; patch only the Docker source copy.
FROM worker-test-builder AS poll-yield-test-builder
ARG BUILD_JOBS=2
COPY test/ocudu/patches/patch-ocudu-zmq-poll-yield.py /tmp/patch-ocudu-zmq-poll-yield.py
RUN python3 /tmp/patch-ocudu-zmq-poll-yield.py /src/ocudu \
    && cmake --build /build/ocudu --target gnb_split_8 --parallel "${BUILD_JOBS}" \
    && install -m 755 /build/ocudu/apps/gnb_split_8/gnb /stage/opt/ocudu/bin/gnb

FROM ubuntu:24.04 AS gnb

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini libfftw3-single3 libmbedcrypto7t64 libsctp1 libyaml-cpp0.8 \
    libzmq5 libssl3t64 libstdc++6 libgcc-s1 \
    iproute2 iputils-ping procps \
    && rm -rf /var/lib/apt/lists/*

COPY --from=poll-yield-test-builder /stage/opt/ocudu/ /opt/ocudu/
COPY ocudu/LICENSE /opt/ocudu/licenses/LICENSE
COPY ocudu/COPYRIGHTS.txt /opt/ocudu/licenses/COPYRIGHTS.txt
COPY ocudu/LICENSES/ /opt/ocudu/licenses/LICENSES/

LABEL org.opencontainers.image.source="https://gitlab.com/ocudu/ocudu" \
      org.opencontainers.image.revision="440cdbbee077e97e824db285bf227c15c84bd0bb"

WORKDIR /opt/ocudu/bin
RUN set -eu; \
    ldd ./gnb > /tmp/gnb-ldd.txt; \
    cat /tmp/gnb-ldd.txt; \
    if grep -q 'not found' /tmp/gnb-ldd.txt; then exit 1; fi; \
    rm /tmp/gnb-ldd.txt

STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/opt/ocudu/bin/gnb"]
CMD ["-c", "/etc/ocudu/gnb.yml"]
