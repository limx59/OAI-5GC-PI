FROM limx59/oai-pi-ocudu-flexric-xapp:arm64-xapp-compatibility-test@sha256:bc6c6f46d8338bfab83d2ccbf7bd578028680d0c114cc99cd72b31646156d587

WORKDIR /opt/ocudu-xapp-compatibility
COPY test/xapp/xapp_qos_watch.py ./
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN python3 -B - <<'CHECK'
from pathlib import Path
for name in ("xapp_kpm.py", "xapp_kpm_recorder.py", "xapp_qos_watch.py"):
    path = Path(name)
    compile(path.read_text(), str(path), "exec")
print("PASS: original shared QoS modules packaged")
CHECK

ENTRYPOINT ["timeout", "--signal=INT", "--kill-after=5s", "45s", "python3", "-B", "-u", "/opt/ocudu-xapp-compatibility/xapp_qos_watch.py"]
CMD ["-c", "/usr/local/etc/flexric/xapp.conf"]
