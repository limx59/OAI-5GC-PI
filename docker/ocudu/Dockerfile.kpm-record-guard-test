FROM ubuntu:24.04 AS test
ARG BUILD_JOBS=1
ARG MCPU=cortex-a76+crypto
ENV DEBIAN_FRONTEND=noninteractive
ENV GTEST_DISCOVERY_TIMEOUT=120

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build pkg-config git ca-certificates \
    python3 libfftw3-dev libmbedtls-dev libsctp-dev libyaml-cpp-dev \
    libzmq3-dev libssl-dev libgtest-dev \
    && rm -rf /var/lib/apt/lists/*

COPY ocudu/ /src/ocudu/
COPY test/ocudu/patches/patch-ocudu-kpm-style4-record-guard.py /tmp/guard.py
COPY test/ocudu/patches/kpm-style4-record-guard-tests.inc /tmp/guard-tests.inc

RUN python3 /tmp/guard.py /src/ocudu \
    && printf '\n' >> /src/ocudu/tests/unittests/e2/e2sm_kpm_test.cpp \
    && cat /tmp/guard-tests.inc >> /src/ocudu/tests/unittests/e2/e2sm_kpm_test.cpp

RUN cmake -S /src/ocudu -B /build/ocudu -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DMCPU="${MCPU}" -DMARCH=armv8.2-a \
    -DBUILD_TESTING=ON \
    -DENABLE_ZEROMQ=ON -DENABLE_EXPORT=ON -DENABLE_FFTW=ON \
    -DENABLE_UHD=OFF -DENABLE_SIDEKIQ=OFF -DENABLE_DIFI=OFF \
    -DENABLE_DPDK=OFF -DENABLE_CUDA=OFF -DENABLE_MKL=OFF \
    -DENABLE_FFTZ=OFF -DENABLE_ARMPL=OFF -DENABLE_BACKWARD=OFF \
    -DENABLE_PLUGINS=OFF \
    && cmake --build /build/ocudu --target e2sm_kpm_test \
       --parallel "${BUILD_JOBS}"

RUN timeout --signal=TERM --kill-after=5s 180s \
    /build/ocudu/tests/unittests/e2/e2sm_kpm_test \
    '--gtest_filter=e2sm_kpm_style4_record_guard.*:e2sm_kpm_report_service_style2_test.*:*e2sm_kpm_generates_ric_indication_style4*'
