FROM limx59/oai-pi-ocudu-flexric-xapp:arm64-xapp-compatibility-test@sha256:bc6c6f46d8338bfab83d2ccbf7bd578028680d0c114cc99cd72b31646156d587

WORKDIR /opt/ocudu-custom-sm-capability
COPY test/ocudu/xapp-custom-sm-capability.py ./probe.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN python3 -B - <<'CHECK'
from pathlib import Path
path = Path("probe.py")
compile(path.read_text(), str(path), "exec")
