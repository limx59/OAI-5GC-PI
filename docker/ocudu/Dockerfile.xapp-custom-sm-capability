ENTRYPOINT ["timeout", "--signal=INT", "--kill-after=5s", "40s", "python3", "-B", "-u", "/opt/ocudu-custom-sm-capability/probe.py"]
CMD ["-c", "/usr/local/etc/flexric/xapp.conf"]
